APP_NAME=Fitness AI Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

POSTGRES_DB=fitness_ai_agent
POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=fitness_password
DATABASE_URL=postgresql+psycopg://fitness_user:fitness_password@db:5432/fitness_ai_agent

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
VISION_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_SECONDS=60

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=fitness_memory
EMBEDDING_MODEL_NAME=nomic-embed-text
REDIS_URL=redis://redis:6379/0

MEAL_IMAGE_UPLOAD_DIR=storage/uploads/meals
MAX_IMAGE_UPLOAD_BYTES=8388608

WHATSAPP_PROVIDER=mock
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_BASE_URL=https://graph.facebook.com
WHATSAPP_META_API_VERSION=v20.0

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SUMMARY_EMAIL_ENABLED=false
SUMMARY_SCHEDULE_ENABLED=false
SUMMARY_SCHEDULE_HOUR=20
SUMMARY_SCHEDULE_MINUTE=0
SUMMARY_SCHEDULE_TIMEZONE=UTC

API_KEY_ENABLED=true
API_KEY=change-me

CLOUDFLARE_TUNNEL_TOKEN=

WEB_CONCURRENCY=2
